{
  "name": "lospor-mobile",
  "version": "10.2.0",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~56.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.2",
    "@lospor/core": "file:../lospor-core",
    "expo": "~56.0.24",
    "expo-constants": "~56.0.22",
    "expo-dev-client": "~56.0.28",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.91.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.3",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-preset-expo": "^56.0.21",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.7",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js app src scripts e2e App.tsx index.ts babel.config.js metro.config.js tailwind.config.js playwright.pwa.config.ts",
    "lint:strict": "npm run lint -- --max-warnings 0 --no-inline-config",
    "check:shared-core": "node scripts/check-shared-core-boundaries.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --testTimeout=30000",
    "check:i18n": "vitest run src/i18n/i18n-parity.test.ts src/i18n/locale.test.ts src/i18n/visible-string-inventory.test.ts src/lib/account-locale.test.ts src/lib/appliance-locale.test.ts src/lib/api-auth.test.ts src/lib/legal-documents.test.ts src/lib/registration-schema.test.ts src/components/localized-surfaces.test.tsx",
    "export:web": "expo export --platform web --clear && node scripts/patch-pwa.mjs",
    "e2e:pwa": "npm run export:web:e2e && playwright test --config playwright.pwa.config.ts",
    "postinstall": "patch-package",
    "export:web:e2e": "node scripts/export-web-for-e2e.mjs"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "nanoid": "^3.3.18",
    "image-size": "2.0.4",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5"
  },
  "private": true
}
