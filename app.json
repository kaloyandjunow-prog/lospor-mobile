{
  "expo": {
    "name": "LOSPOR",
    "slug": "lospor-mobile",
    "version": "9.9.5",
    "scheme": "lospor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lospor.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "org.lospor.mobile",
      "versionCode": 43,
      "adaptiveIcon": {
        "backgroundColor": "#090b0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "LOSPOR",
      "shortName": "LOSPOR",
      "description": "Отворен периоперативен регистър — клинична анестезиологична документация",
      "themeColor": "#090b0c",
      "backgroundColor": "#090b0c",
      "lang": "bg",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "bg",
              "en"
            ],
            "android": [
              "bg",
              "en"
            ]
          }
        }
      ],
      "expo-status-bar",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "LOSPOR използва снимките за разчитане на лабораторни резултати и мониторни показатели.",
          "cameraPermission": "LOSPOR използва камерата за разчитане на лабораторни резултати и мониторни показатели."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090b0c"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#16b1a9",
          "defaultChannel": "reminders"
        }
      ],
      "expo-sharing"
    ],
    "locales": {
      "bg": "./locales/bg.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b87b715-f0c9-4c6f-b40c-4ade6693b77d"
      }
    },
    "owner": "kaloyandzhunov"
  }
}
